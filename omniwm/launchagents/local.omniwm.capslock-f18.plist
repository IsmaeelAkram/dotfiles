<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Remaps Caps Lock to F18 at login; OmniWM's systemHyperTrigger = "F18" makes it Hyper.
    OmniWM's own "Caps Lock" trigger does the same remap but toggles Caps Lock on a quick tap,
    with no setting to turn that off. Through this remap, Caps Lock never locks.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.omniwm.capslock-f18</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/hidutil</string>
        <string>property</string>
        <string>--set</string>
        <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x70000006D}]}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
